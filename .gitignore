# Ignore the virtual environment folder
venv/
.venv/
env/

#ignore zip files
*.zip

#ignore workspace
*.code-workspace

#ignore backup files
*-bk*

#ignore kodi folder
xbmc/

# Ignore vendored addon libraries (keeps repo small)
service.sendspin/resources/lib/

# Locally/CI-built native backend; release packaging includes it in the ZIP.
service.sendspin/resources/bin/*
!service.sendspin/resources/bin/README.md

# Deployment script (machine-specific)
upload
sendspin-protocol.txt
KodiDevelopment.html
log.txt
Plan.txt

# Common Python / editor ignores
__pycache__/
*.py[cod]
*.so
*.egg-info/
*.dist-info/
.env
.DS_Store
.vscode/
.idea/
*.py.txt
.ruff_cache/

# Ignore sync conflict files
*.sync-conflict-*

# Native/CMake build tree
build/

# Runtime state generated by the native Kodi container harness
tests/kodi/.native-runtime/

# Ignore AI exclusion file
.aiexclude

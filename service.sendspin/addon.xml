<?xml version="1.0" encoding="UTF-8"?>
<addon id="service.sendspin" name="Sendspin" version="0.1.0" provider-name="Shards">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <!-- Changed to pluginsource for an app-like interface -->
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>audio</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Sendspin Audio App</summary>
    <description lang="en_GB">Interface app to manage Sendspin Docker playback with native Kodi player controls.</description>
    <platform>all</platform>
    <assets><icon>icon.png</icon></assets>
  </extension>
</addon>

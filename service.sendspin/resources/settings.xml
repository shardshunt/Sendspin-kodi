<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings>
    <category label="32001">
        <setting type="sep"/>
    </category>

    <category label="Playback">
        <setting id="delay_ms" type="number" label="Static playback delay (ms)" default="0" low="0" high="5000" step="50" />
        <setting id="volume_scale" type="text" label="Kodi to Sendspin volume scale" default="0.3" />
    </category>

    <category label="Connection">
        <setting id="proxy_port" type="number" label="Local proxy port" default="59999" advanced="true" />
        <setting id="control_url" type="text" label="Container control API URL" default="http://127.0.0.1:59999" advanced="true" />
    </category>

    <category label="Client">
        <setting id="docker_container_name" type="text" label="Docker container name" default="sendspin-player" />
        <setting id="docker_image_name" type="text" label="Docker image name" default="ghcr.io/shardshunt/sendspin-cli-for-sendspin-kodi" advanced="true" />
        <setting id="docker_config_dir" type="text" label="Docker config directory" default="/storage/.config/sendspin" />
        <setting id="docker_start_enabled" type="bool" label="Start Docker backend" default="true" />
        <setting id="audio_device_override" type="text" label="Audio device ID override (leave empty to auto-detect)" default="" advanced="true" />
        <setting id="fallback_audio_device" type="text" label="Fallback audio device ID" default="8" />
        <setting id="instance_guard_enabled" type="bool" label="Enable multi-instance guard" default="true" />
        <setting id="activate_visualisation_enabled" type="bool" label="Activate visualisation window" default="true" />
        <setting id="require_dummy_playback" type="bool" label="Stop when dummy playback stops" default="true" />
    </category>
</settings>
